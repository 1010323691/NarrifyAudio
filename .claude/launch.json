{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "vite",
      "runtimeExecutable": "npm.cmd",
      "runtimeArgs": ["run", "dev"],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "narrify-all",
      "runtimeExecutable": "powershell",
      "runtimeArgs": [
        "-NoProfile",
        "-ExecutionPolicy", "Bypass",
        "-Command",
        "& .\\launch\\start.ps1; Read-Host '全栈已拉起（Backend/Worker/Frontend 各自独立窗口运行）；本窗口只是启动器，关掉不影响服务'"
      ],
      "port": 5173,
      "autoPort": true
    }
  ]
}
