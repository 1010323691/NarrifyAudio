# Copy to .env for local Windows development. Do not commit the real file.
NARRIFY_DATABASE_URL=postgresql+psycopg://narrify:replace-with-a-long-random-password@127.0.0.1:5432/narrify
NARRIFY_REDIS_URL=redis://127.0.0.1:6379/0
# Per-process pools. The standard backend.worker entrypoint selects worker defaults.
NARRIFY_API_DB_POOL_SIZE=16
NARRIFY_API_DB_POOL_MAX_OVERFLOW=0
NARRIFY_API_DB_LOCK_POOL_SIZE=8
NARRIFY_API_DB_LOCK_POOL_MAX_OVERFLOW=0
NARRIFY_WORKER_DB_POOL_SIZE=6
NARRIFY_WORKER_DB_POOL_MAX_OVERFLOW=0
NARRIFY_WORKER_DB_POOL_TIMEOUT=30
NARRIFY_WORKER_DB_LOCK_POOL_SIZE=1
NARRIFY_WORKER_DB_LOCK_POOL_MAX_OVERFLOW=0
NARRIFY_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
NARRIFY_BOOTSTRAP_ADMIN_PASSWORD=replace-with-another-long-random-password
