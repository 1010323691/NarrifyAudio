# NarrifyAudio backend layering contract (plan S3/Q17, batch 2 "import-linter rule in place").
# Read by import-linter (dev-only, not in requirements files). Run with:
#   .venv\Scripts\lint-imports
# Config syntax: https://import-linter.readthedocs.io/en/latest/reference/user_interface.html
# Keep this file ASCII-only: the linter reads it with the platform default encoding.

[importlinter]
root_package = backend

[importlinter:backend_layering]
name = backend layering api -> services -> platform -> core (engines/worker/main not layered yet)
type = layers
layers =
    backend.api
    backend.services
    backend.platform
    backend.core
ignore_imports =
    backend.platform.bootstrap -> backend.services.projects

# The one ignore_import above is the third reverse edge lint-imports surfaced
# in platform.bootstrap (plan S3/Q17 documented only two). Batch 3 fixes it,
# then removes this line so the contract is fully strict.
