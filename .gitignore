# --- Node / 前端 ---
node_modules
dist
*.local
.env
npm-debug.log*
yarn-error.log*

# --- Python 后端 + TTS ---
# Shared Python environment（backend + TTS，数 GB）
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.pytest-review-*/
.import_linter_cache/
# TTS 环境安装脚本的运行日志（每次运行重写）
install_tts_env.log

# --- 本机运行时配置 ---
# 根目录 setting.json 作为无凭据的配置模板跟踪；旧版根目录 app.json 仍忽略
/app.json
# Application-level recent workspace history (contains local paths)
/config/
# 全局音乐库（背景音乐系统；跨工程共享，工作空间外，代码常量固定位置）
/music_library/

# NarrifyAudio persistent platform runtime (database, object storage, local secrets)
/.narrify/
/storage/
# 本机存储根目录位置（管理控制台选定；per-user 运行时数据，永不提交）
/workspace/

# 0015 migration backup dumps (contain user data — never commit)
.backups/

# 运行时日志目录（本机产物；launch/dev-all.ps1 写入 logs/dev/）
logs/

# design/ 目录保留在仓库中，但内部内容（计划/开发目标文档）不提交
design/*
!design/.gitkeep

# --- 系统 / 编辑器 ---
.DS_Store
