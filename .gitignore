# --- Node / 前端 ---
node_modules
dist
*.local
.env
npm-debug.log*
yarn-error.log*

# --- Python 后端 + TTS ---
# Shared Python environment（backend + TTS，数 GB）
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.import_linter_cache/
# TTS 环境安装脚本的运行日志（每次运行重写）
install_tts_env.log

# --- 运行时配置 / 工作空间指针（含本机路径与密钥，不入库）---
# 根目录 app.json = 通用配置模板 + 当前工作空间指针；产物 / 日志 / 工程配置都在用户工作空间内
/app.json
# Application-level recent workspace history (contains local paths)
/config/
# 全局音乐库（背景音乐系统；跨工程共享，工作空间外，代码常量固定位置）
/music_library/

# NarrifyAudio persistent platform runtime (database, object storage, local secrets)
/.narrify/
/storage/
# agent 交接资料（docs/agent-context/）已入库；archify 图表产物若落在 docs/ 下，按需补子路径忽略规则

# 0015 migration backup dumps (contain user data — never commit)
.backups/

# 运行时日志目录（本机产物；scripts/dev-all.ps1 写入 logs/dev/）
logs/

# --- 系统 / 编辑器 ---
.DS_Store
